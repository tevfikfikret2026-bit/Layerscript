// src/lexer.ts

export type TokenType = 
    | "KEYWORD"     // layer
    | "BIND"        // <-
    | "IDENTIFIER"  // submitBtn, score
    | "ELEMENT"     // Button, Div, Input
    | "SELECTOR"    // "#submit", ".main-container"
    | "STRING"      // "Hello World"
    | "NUMBER"      // 10, 20
    | "OPERATOR"    // =, +, ?, :
    | "LBRACE"      // {
    | "RBRACE"      // }
    | "LPAREN"      // (
    | "RPAREN";     // )

export interface Token {
    type: TokenType;
    value: string;
}

export function tokenize(sourceCode: string): Token[] {
    const tokens: Token[] = [];
    // LayerScript'in özel karakterlerini (<- dahil) tanıyan düzenli ifade
    const regex = /\s*(<-|layer|Button|Div|Input|[\{\}\(\)=\+\?\:]|[a-zA-Z_][a-zA-Z0-9_]*|[0-9]+|"[^"\\]*")\s*/g;
    let match;

    while ((match = regex.exec(sourceCode)) !== null) {
        const value = match[1];
        
        if (value === "layer") tokens.push({ type: "KEYWORD", value });
        else if (value === "<-") tokens.push({ type: "BIND", value });
        else if (["Button", "Div", "Input"].includes(value)) tokens.push({ type: "ELEMENT", value });
        else if (value.startsWith('"') && value.endsWith('"')) {
            if (value.startsWith('"#') || value.startsWith('".')) {
                tokens.push({ type: "SELECTOR", value: value.replace(/"/g, '') });
            } else {
                tokens.push({ type: "STRING", value });
            }
        }
        else if (!isNaN(Number(value))) tokens.push({ type: "NUMBER", value });
        else if (value === "{") tokens.push({ type: "LBRACE", value });
        else if (value === "}") tokens.push({ type: "RBRACE", value });
        else if (value === "(") tokens.push({ type: "LPAREN", value });
        else if (value === ")") tokens.push({ type: "RPAREN", value });
        else if (["=", "+", "?", ":"].includes(value)) tokens.push({ type: "OPERATOR", value });
        else tokens.push({ type: "IDENTIFIER", value });
    }

    return tokens;
}
